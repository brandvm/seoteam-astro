---
import '../styles/global.css';
import '../styles/site-mode.css';
import Icon from '../components/Icon.astro';
import copy from '../data/copy.json';
import {cases, testimonials, articles, industries} from '../data/results';
import epilogueFont from '../assets/fonts/epilogue.woff2?url';
import rubikFont from '../assets/fonts/rubik.woff2?url';
const text = (section: number, type: string) => copy[section].find(row => row.type === type)?.text || '';
const origin = 'https://www.seoteamtoronto.ca';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const asset = (name: string) => `${base}assets/${name}`;
const clientLogos = [
  ['mcgill','McGill'], ['tdsb','Toronto District School Board'],
  ['forest-hill','Forest Hill Real Estate'], ['dress-for-success','Dress for Success Toronto'],
  ['alberta-municipalities','Alberta Municipalities'], ['retina-labs','Retina Labs'],
];
const services = copy[1].reduce<Array<{title:string;body:string;link:string}>>((all,row) => {
  if(row.type === 'H3') all.push({title:row.text,body:'',link:''});
  else if(all.length && row.type === 'Body') all[all.length-1].body = row.text;
  else if(all.length && row.type === 'Link') all[all.length-1].link = row.text.replace(' →','');
  return all;
},[]);
const serviceUrls = ['/services/technical-seo','/services/ai-readiness','/services/ppc-management','/services/toronto-digital-marketing'];
const serviceIcons = ['chart','layers','target','globe'];
const heroCases = [
  {study:cases[1], channel:'Organic search', legacy:2},
  {study:cases[2], channel:'Organic & paid', legacy:3},
  {study:cases[3], channel:'Organic search', legacy:null},
];
const differences = copy[2].reduce<Array<{title:string;body:string;tools:Array<{title:string;body:string}>}>>((all,row) => {
  if(row.type === 'H3') all.push({title:row.text,body:'',tools:[]});
  else if(all.length && row.type === 'H4') all[all.length-1].tools.push({title:row.text,body:''});
  else if(all.length && row.type === 'Body') {
    const block = all[all.length-1];
    if(block.tools.length) block.tools[block.tools.length-1].body=row.text;else block.body=row.text;
  }
  return all;
},[]);
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>SEO Team Toronto — The Pioneer Toronto SEO Agency</title>
  <meta name="description" content="A Toronto SEO agency connecting organic growth, AI search visibility, and marketing strategy. Research-led consulting built around your business goals."/>
  <meta name="robots" content="noindex,nofollow"/>
  <meta name="theme-color" content="#200f09"/>
  <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')}/>
  <link rel="preload" as="font" type="font/woff2" crossorigin href={epilogueFont}/>
  <link rel="preload" as="font" type="font/woff2" crossorigin href={rubikFont}/>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container nav-shell">
    <a href={base} class="brand" aria-label="SEO Team Toronto home"><img src={asset('seo-team-logo.svg')} width="131" height="58" alt="SEO Team Toronto"/></a>
    <span class="brand-location">Toronto, Ontario<br/><span>SEO & AI search consultants</span></span>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="#services" data-review-anchor="header:a:1">Services</a><a href="#why-seo-team" data-review-anchor="header:a:2">Why SEO Team</a><a href="#case-studies" data-review-anchor="header:a:3">Our Work</a><a href="#research" data-review-anchor="header:a:4">Insights</a>
    </nav>
    <a href={origin+'/contact'} class="button button-small nav-cta" data-review-anchor="header:a:5">Speak With a Consultant <Icon size={17}/></a>
    <details class="mobile-menu"><summary aria-label="Toggle navigation"><Icon name="menu"/></summary><nav aria-label="Mobile navigation"><a href="#services" data-review-anchor="header:a:6">Services</a><a href="#why-seo-team" data-review-anchor="header:a:7">Why SEO Team</a><a href="#case-studies" data-review-anchor="header:a:8">Our Work</a><a href="#research" data-review-anchor="header:a:9">Insights</a><a href={origin+'/contact'} data-review-anchor="header:a:10">Speak With a Consultant</a></nav></details>
  </div>
</header>
<main id="main">
  <section id="hero" class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> SEO. AI Search. Business Growth.</div>
        <h1 id="hero-title">The Pioneer<br/>Toronto<br/><span>SEO Agency.</span></h1>
        <p>{text(0,'Body')}</p>
        <div class="hero-actions"><a href={origin+'/contact'} class="button" data-review-anchor="hero:a:0">{text(0,'Primary CTA')} <Icon size={19}/></a><a href="#case-studies" class="text-link">View client results <Icon size={18}/></a></div>
        <div class="hero-note"><Icon name="check" size={16}/> Experienced consultants. A clear way forward.</div>
      </div>
      <div class="hero-results" aria-label="Results from individual client engagements">
        <div class="hero-results-label"><span class="eyebrow">Our clients. Their growth.</span><Icon name="chart" size={22}/></div>
        {heroCases.map(({study,channel,legacy})=><a class="hero-result" href={origin+study.href} data-review-anchor={legacy ? `hero:a:${legacy}` : 'hero:donation-result'}>
          <div><p class="result-client" data-review-anchor={legacy ? `hero:p:${legacy}` : 'hero:donation-client'}>{study.client} <span>· {channel}</span></p><strong>{study.value}</strong><h2>{study.metric}</h2></div>
          <Icon size={22}/>
        </a>)}
        <p class="hero-results-note" data-review-anchor="hero:p:4">Reported results from individual client engagements. <a href="#case-studies">Explore the work <Icon size={14}/></a></p>
      </div>
    </div>
    <div class="container client-strip">
      <p>Experience behind brands that make a difference.</p>
      <div class="client-logos">{clientLogos.map(([file,name])=><img src={asset(`clients/logo-${file}.png`)} alt={name} width="480" height="200" decoding="async"/>)}</div>
    </div>
  </section>
  <section id="services" class="section services-section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading split-heading">
        <div><div class="eyebrow"><span class="eyebrow-line"></span>{text(1,'Eyebrow')}</div><h2 id="services-title">{text(1,'H2')}</h2></div>
        <p>{text(1,'Intro')}</p>
      </div>
      <div class="services-grid">
        {services.map((service,i) => <article class="service-card">
          <div class="service-top"><span class="service-icon"><Icon name={serviceIcons[i]} size={27}/></span><span class="item-number">0{i+1}</span></div>
          <h3>{service.title}</h3><p>{service.body}</p>
          <a class="text-link" href={origin+serviceUrls[i]}>{service.link}<Icon size={19}/></a>
        </article>)}
      </div>
    </div>
  </section>
  <section id="why-seo-team" class="section why-section" aria-labelledby="why-title">
    <div class="container why-feature">
      <div class="why-intro"><div class="eyebrow"><span class="eyebrow-line"></span>{text(2,'Eyebrow')}</div><h2 id="why-title">{text(2,'H2')}</h2><p>{text(2,'Intro')}</p><div class="why-principles"><span><Icon name="check" size={18}/> Original research</span><span><Icon name="check" size={18}/> Experienced judgement</span><span><Icon name="check" size={18}/> A personal consulting relationship</span></div><a class="text-link" href={origin+'/about-us'}>Meet SEO Team <Icon size={19}/></a></div>
      <div class="expertise-proof">
        <div class="experience-card"><strong>10<span>+</span></strong><p>Years of experience<br/>in organic search</p></div>
        <div class="performance-proof">
          <div class="proof-label"><span class="eyebrow">Flipp · Technical SEO</span><Icon name="chart" size={22}/></div>
          <h3>A stronger technical foundation.</h3>
          <p>Mobile Core Web Vitals pass rate</p>
          <div class="performance-chart" role="img" aria-label="Flipp mobile Core Web Vitals pass rate improved from 62 percent to 94 percent, on a scale of zero to 100 percent.">
            <div class="performance-row"><span>Before</span><div class="performance-track"><i style="width:62%"></i></div><strong>62%</strong></div>
            <div class="performance-row performance-after"><span>After</span><div class="performance-track"><i style="width:94%"></i></div><strong>94%</strong></div>
            <div class="performance-scale" aria-hidden="true"><span>0%</span><span>100%</span></div>
          </div>
          <a class="text-link" href={origin+cases[0].href}>See the Flipp case study <Icon size={18}/></a>
        </div>
      </div>
    </div>
    <div class="container recognition"><span class="eyebrow">Recognition<br/>& partnerships</span><div class="recognition-badges"><img src={asset('badges/clutch-canada-2025.png')} width="113" height="150" loading="lazy" decoding="async" alt="Clutch Top Technical SEO Canada 2025"/><img src={asset('badges/semrush.png')} width="114" height="150" loading="lazy" decoding="async" alt="Semrush Certified Agency Partner"/><img src={asset('badges/upcity.png')} width="124" height="150" loading="lazy" decoding="async" alt="Top SEO Agency featured on UpCity"/></div></div>
    <div class="why-details"><div class="container differences">
      {differences.map((block,i)=><article class="difference" data-review-anchor={`why-seo-team:article:${i}`}>
        <div class="difference-heading"><span class="item-number">0{i+1}</span><h3>{block.title}</h3></div>
        <p>{block.body}</p>
        {block.tools.length>0 && <div class="technology-grid">{block.tools.map((tool,j)=><div class="technology"><div class="technology-title"><Icon name={j===0?'target':'globe'} size={25}/><h4>{tool.title}</h4></div><p>{tool.body}</p></div>)}</div>}
      </article>)}
    </div></div>
  </section>
  <section id="approach" class="section approach-section" aria-labelledby="approach-title">
    <div class="container approach-grid">
      <div class="approach-copy"><div class="eyebrow"><span class="eyebrow-line"></span>{text(3,'Eyebrow')}</div><h2 id="approach-title">{text(3,'H2')}</h2><p>{text(3,'Body')}</p></div>
      <div class="authority-diagram" aria-label="A connected strategy for SEO, GEO and AEO">
        <div class="diagram-caption"><span class="eyebrow">One connected strategy</span></div>
        <div class="search-channels"><div class="channel"><Icon name="search" size={28}/><strong>SEO</strong><span>Organic<br/>search</span></div><div class="channel"><Icon name="globe" size={28}/><strong>GEO</strong><span>Generative<br/>engines</span></div><div class="channel"><Icon name="bolt" size={28}/><strong>AEO</strong><span>Answer<br/>engines</span></div></div>
        <div class="channel-connector" aria-hidden="true"><span></span></div>
        <div class="authority-core"><Icon name="layers" size={28}/><strong>Brand authority</strong><span>Credible expertise, wherever customers search.</span></div>
        <div class="diagram-foundation"><span>Your website</span><span>Your expertise</span><span>Trusted sources</span></div>
      </div>
    </div>
  </section>
  <section id="case-studies" class="section cases-section" aria-labelledby="cases-title">
    <div class="container">
      <div class="section-heading case-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>{text(4,'Eyebrow')}</div><h2 id="cases-title">{text(4,'H2')}</h2><p>{text(4,'Body')}</p></div><a class="text-link" href={origin+'/case-studies'}>{text(4,'Link').replace(' →','')}<Icon size={20}/></a></div>
      <article class="featured-case" data-review-anchor="case-studies:article:0">
        <div class="featured-case-visual"><img src={asset('images/toronique-1040.webp')} srcset={`${asset('images/toronique-520.webp')} 520w, ${asset('images/toronique-1040.webp')} 1040w`} sizes="(max-width:420px) 76vw, 320px" width="1040" height="1256" loading="lazy" decoding="async" alt="Toronique website mockup with a card reporting 3.1x Google Business Profile calls and direction requests."/></div>
        <div class="featured-case-copy"><span class="eyebrow">Featured engagement · Toronique</span><h3>{cases[2].name}</h3><p class="featured-case-focus">{cases[2].focus}</p><div class="featured-case-stats"><div><strong>+210<span>%</span></strong><p>Qualified consultation requests</p></div><div><strong>3.1<span>×</span></strong><p>Google Business Profile calls & directions</p></div></div><p class="featured-case-context">Organic search and paid media, working together to reach homeowners planning their next build.</p><a href={origin+cases[2].href} class="text-link">Explore the Toronique Case Study <Icon size={21}/></a></div>
      </article>
      <div class="case-grid">{cases.filter((study)=>study.client!=='Toronique').map((study,i)=><article class="case-card" data-review-anchor={`case-studies:article:${i+1}`}>
        <div class="case-top"><span class="eyebrow">{study.industry}</span><Icon name={['layers','briefcase','heart'][i]} size={24}/></div>
        <span class="case-client">{study.client}</span>
        <div class="case-stat">{study.value}</div><p class="case-metric">{study.metric}</p>
        <p class="case-secondary">{study.secondary}</p>
        <div class="case-detail"><h3>{study.name}</h3><p>{study.focus}</p><a href={origin+study.href} class="text-link">Read Case Study <Icon size={18}/></a></div>
      </article>)}</div>
      <p class="results-note" data-review-anchor="case-studies:p:14">Reported results from individual client engagements. Follow each case study for the context and work behind the outcome.</p>
    </div>
  </section>
  <section id="industries" class="section industries-section" aria-labelledby="industries-title">
    <div class="container industry-layout">
      <div class="section-heading"><div class="eyebrow"><span class="eyebrow-line"></span>{text(5,'Eyebrow')}</div><h2 id="industries-title">{text(5,'H2')}</h2><p>{text(5,'Body')}</p><a href={origin+'/case-studies'} class="text-link">{text(5,'Link').replace(' →','')}<Icon size={20}/></a></div>
      <div class="industry-grid">{industries.map(industry=><a href={origin+industry.href} class="industry-link"><Icon name={industry.icon} size={23}/><span>{industry.name}</span><Icon size={17}/></a>)}</div>
    </div>
  </section>
  <section id="research" class="section research-section" aria-labelledby="research-title">
    <div class="container">
      <div class="section-heading case-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>{text(6,'Eyebrow')}</div><h2 id="research-title">{text(6,'H2')}</h2><p>{text(6,'Body')}</p></div><a href={origin+'/blog'} class="text-link">{text(6,'Link').replace(' →','')}<Icon size={20}/></a></div>
      <div class="research-layout">
        <article class="research-feature"><a class="research-image" href={origin+articles[2].href} tabindex="-1" aria-hidden="true"><img src={asset('images/seo-timeline-1240.webp')} srcset={`${asset('images/seo-timeline-620.webp')} 620w, ${asset('images/seo-timeline-1240.webp')} 1240w`} sizes="(max-width:760px) 90vw, 46vw" width="1240" height="826" loading="lazy" decoding="async" alt=""/></a><div class="article-heading"><span class="eyebrow">{articles[2].category}</span><h3><a href={origin+articles[2].href}>{articles[2].title}</a></h3></div><p>{articles[2].description}</p><a href={origin+articles[2].href} class="text-link">Read the Research <Icon size={20}/></a></article>
        <div class="article-list">{articles.slice(0,2).map((article)=><article class="article-row"><div class="article-heading"><span class="eyebrow">{article.category}</span><h3><a href={origin+article.href}>{article.title}</a></h3></div><p>{article.description}</p><a href={origin+article.href} class="text-link">Read the Research <Icon size={20}/></a></article>)}</div>
      </div>
    </div>
  </section>
  <section id="testimonials" class="section testimonials-section" aria-labelledby="testimonials-title">
    <div class="container testimonial-layout">
      <div class="section-heading"><div class="eyebrow"><span class="eyebrow-line"></span>{text(7,'Eyebrow')}</div><h2 id="testimonials-title">{text(7,'H2')}</h2><p>{text(7,'Body')}</p></div>
      <div class="testimonial-carousel" role="region" aria-roledescription="carousel" aria-label="Client testimonials">
        <span class="quote-mark" aria-hidden="true">“</span>
        <div id="testimonial-slides" aria-live="polite">{testimonials.map((review,i)=><figure class="testimonial-slide" data-slide={i} role="group" aria-roledescription="slide" aria-label={`${i+1} of ${testimonials.length}`}>
          <blockquote>{review.quote}</blockquote><figcaption><strong>{review.name}</strong><span>{review.role}</span><a class="review-source" href={origin+review.href}>Read their case study <Icon size={14}/></a></figcaption>
        </figure>)}</div>
        <div class="testimonial-controls" hidden><div class="slide-dots" aria-label="Choose a testimonial">{testimonials.map((review,i)=><button type="button" data-go-to={i} aria-label={`Show testimonial from ${review.name}`} aria-pressed={i===0}><span></span></button>)}</div><div class="slide-navigation"><span id="slide-status">01 / 04</span><button type="button" class="round-link previous-slide" aria-label="Previous testimonial"><Icon size={20}/></button><button type="button" class="round-link next-slide" aria-label="Next testimonial"><Icon size={20}/></button></div></div>
      </div>
    </div>
  </section>
  <section id="contact" class="section contact-section" aria-labelledby="contact-title">
    <div class="container contact-layout"><div><div class="eyebrow"><span class="eyebrow-line"></span>{text(8,'Eyebrow')}</div><h2 id="contact-title">{text(8,'H2')}</h2><p>{text(8,'Body')}</p></div><div class="contact-actions"><a class="button" href={origin+'/contact'}>Speak With a Consultant <Icon size={20}/></a><a href="mailto:info@seoteamtoronto.ca" class="contact-link"><Icon name="mail" size={18}/><span>info@seoteamtoronto.ca</span></a><a href="tel:+14163603434" class="contact-link"><Icon name="phone" size={18}/><span>+1 416 360-3434</span></a></div></div>
  </section>
</main>
<footer class="site-footer"><div class="container"><div class="footer-top"><a href={base} class="brand" aria-label="SEO Team Toronto home"><img src={asset('seo-team-logo.svg')} width="131" height="58" alt="SEO Team Toronto" loading="lazy"/></a><p>60 Bloor St W, Unit 401<br/>Toronto, ON M4W 3B8</p><nav aria-label="Footer navigation"><a href={origin+'/about-us'}>About Us</a><a href="#services">Services</a><a href="#case-studies">Case Studies</a><a href="#research">Insights</a><a href="#contact">Contact</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} SEO Team Toronto. All rights reserved.</span><a href="https://www.brandvm.com/">In affiliation with <strong>Brand Vision</strong> <Icon name="external" size={13}/></a></div></div></footer>
<nav id="site-mode" class="site-mode" aria-label="Page mode" hidden>
  <button type="button" data-site-mode="browse" aria-pressed="false" title="Browse the page (V)" aria-keyshortcuts="V">Browse (V)</button>
  <button type="button" data-site-mode="review" aria-pressed="false" title="Click or drag to comment (C)" aria-keyshortcuts="C">Comment (C)</button>
  <div id="review-tools" hidden></div>
</nav>
<p id="site-mode-status" class="site-mode-status" role="status" aria-live="polite" hidden></p>
<script>
  import '../scripts/site-mode';
  const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus();}});
  document.addEventListener('click',event=>{if(menu?.open&&event.target instanceof Node&&!menu.contains(event.target))menu.open=false;});
  const carousel=document.querySelector<HTMLElement>('.testimonial-carousel');
  if(carousel){
    const slides=Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots=Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-go-to]'));
    const controls=carousel.querySelector<HTMLElement>('.testimonial-controls');
    const status=carousel.querySelector<HTMLElement>('#slide-status');
    let active=0;
    const show=(index:number)=>{active=(index+slides.length)%slides.length;slides.forEach((slide,i)=>{slide.hidden=i!==active;});dots.forEach((dot,i)=>dot.setAttribute('aria-pressed',String(i===active)));if(status)status.textContent=`${String(active+1).padStart(2,'0')} / ${String(slides.length).padStart(2,'0')}`;};
    carousel.querySelector('.previous-slide')?.addEventListener('click',()=>show(active-1));
    carousel.querySelector('.next-slide')?.addEventListener('click',()=>show(active+1));
    dots.forEach((dot,i)=>dot.addEventListener('click',()=>show(i)));
    show(0);if(controls)controls.hidden=false;
  }
</script>
</body>
</html>
