---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import copy from '../data/copy.json';
import {cases, testimonials, articles, industries} from '../data/results';
import epilogueFont from '../assets/fonts/epilogue.woff2?url';
import rubikFont from '../assets/fonts/rubik.woff2?url';
const text = (section: number, type: string) => copy[section].find(row => row.type === type)?.text || '';
const origin = 'https://www.seoteamtoronto.ca';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const asset = (name: string) => `${base}assets/${name}`;
const services = copy[1].reduce<Array<{title:string;body:string;link:string}>>((all,row) => {
  if(row.type === 'H3') all.push({title:row.text,body:'',link:''});
  else if(all.length && row.type === 'Body') all[all.length-1].body = row.text;
  else if(all.length && row.type === 'Link') all[all.length-1].link = row.text.replace(' →','');
  return all;
},[]);
const serviceUrls = ['/services/technical-seo','/services/ai-readiness','/services/ppc-management','/services/toronto-digital-marketing'];
const serviceIcons = ['chart','layers','target','globe'];
const differences = copy[2].reduce<Array<{title:string;body:string;tools:Array<{title:string;body:string}>}>>((all,row) => {
  if(row.type === 'H3') all.push({title:row.text,body:'',tools:[]});
  else if(all.length && row.type === 'H4') all[all.length-1].tools.push({title:row.text,body:''});
  else if(all.length && row.type === 'Body') {
    const block = all[all.length-1];
    if(block.tools.length) block.tools[block.tools.length-1].body=row.text;else block.body=row.text;
  }
  return all;
},[]);
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>SEO Team Toronto — The Pioneer Toronto SEO Agency</title>
  <meta name="description" content="A Toronto SEO agency connecting organic growth, AI search visibility, and marketing strategy. Research-led consulting built around your business goals."/>
  <meta name="robots" content="noindex,nofollow"/>
  <meta name="theme-color" content="#200f09"/>
  <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')}/>
  <link rel="preload" as="font" type="font/woff2" crossorigin href={epilogueFont}/>
  <link rel="preload" as="font" type="font/woff2" crossorigin href={rubikFont}/>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container nav-shell">
    <a href={base} class="brand" aria-label="SEO Team Toronto home"><img src={asset('seo-team-logo.svg')} width="131" height="58" alt="SEO Team Toronto"/></a>
    <span class="brand-location">Toronto, Ontario<br/><span>SEO & AI search consultants</span></span>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="#services">Services</a><a href="#why-seo-team">Why SEO Team</a><a href="#case-studies">Our Work</a><a href="#research">Insights</a>
    </nav>
    <a href="#contact" class="button button-small nav-cta">Speak With a Consultant <Icon size={17}/></a>
    <details class="mobile-menu"><summary aria-label="Toggle navigation"><Icon name="menu"/></summary><nav aria-label="Mobile navigation"><a href="#services">Services</a><a href="#why-seo-team">Why SEO Team</a><a href="#case-studies">Our Work</a><a href="#research">Insights</a><a href="#contact">Speak With a Consultant</a></nav></details>
  </div>
</header>
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> SEO. AI Search. Business Growth.</div>
        <h1 id="hero-title">The Pioneer<br/>Toronto <span>SEO<br class="desktop-break"/> Agency.</span></h1>
        <p>{text(0,'Body')}</p>
        <a href="#contact" class="button">{text(0,'Primary CTA')} <Icon size={19}/></a>
        <div class="hero-note"><Icon name="check" size={16}/> Experienced consultants. A clear way forward.</div>
      </div>
      <div class="hero-evidence">
        <div class="evidence-heading"><span class="eyebrow">The work. The impact.</span><span class="case-index">Client result</span></div>
        <div class="feature-metric"><span>+128<span class="percent">%</span></span><Icon name="chart" size={38}/></div>
        <h2>B2B search impressions</h2>
        <p class="evidence-description">Making an enterprise retail-tech platform<br class="desktop-break"/> visible to the right buyers.</p>
        <div class="performance-chart" role="img" aria-label="B2B search impressions increased 128 percent. Indexed baseline: 100. Result: 228.">
          <div class="chart-scale"><span>Search impressions</span><span>Indexed to 100</span></div>
          <div class="chart-row"><span>Before</span><div class="bar-track"><div class="bar bar-before" style="--bar-width:40%">100</div></div></div>
          <div class="chart-row"><span>After</span><div class="bar-track"><div class="bar bar-after" style="--bar-width:91.2%">228 <span>↗</span></div></div></div>
          <div class="chart-axis"><span>0</span><span>100</span><span>200</span><span>250</span></div>
        </div>
        <div class="evidence-bottom"><div><strong>62% <span>→</span> 94%</strong><span>Core Web Vitals pass rate</span></div><a href={origin+'/case-studies/enterprise-retail-tech-technical-seo'} class="round-link" aria-label="Read the enterprise retail-tech case study"><Icon/></a></div>
        <a class="evidence-source" href={origin+'/case-studies/enterprise-retail-tech-technical-seo'}>From our enterprise retail-tech case study</a>
      </div>
    </div>
    <div class="container proof-strip">
      <div class="proof-intro"><span class="eyebrow">Strategy in action</span><p>Different challenges.<br/>Measurable progress.</p></div>
      <a href={origin+'/case-studies/personal-injury-law-local-seo-toronto'}><span class="proof-number">+117<span>%</span></span><span>Qualified organic leads <Icon size={15}/></span><small>Legal services</small></a>
      <a href={origin+'/case-studies/custom-home-builder-seo-ppc-toronto'}><span class="proof-number">+210<span>%</span></span><span>Qualified consultations <Icon size={15}/></span><small>Custom home building · organic & paid</small></a>
      <a href={origin+'/case-studies/nonprofit-seo-toronto'}><span class="proof-number">+120<span>%</span></span><span>Donation form submissions <Icon size={15}/></span><small>Nonprofit</small></a>
    </div>
  </section>
  <section id="services" class="section services-section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading split-heading">
        <div><div class="eyebrow"><span class="eyebrow-line"></span>{text(1,'Eyebrow')}</div><h2 id="services-title">{text(1,'H2')}</h2></div>
        <p>{text(1,'Intro')}</p>
      </div>
      <div class="services-grid">
        {services.map((service,i) => <article class="service-card">
          <div class="service-top"><span class="service-icon"><Icon name={serviceIcons[i]} size={27}/></span><span class="item-number">0{i+1}</span></div>
          <h3>{service.title}</h3><p>{service.body}</p>
          <a class="text-link" href={origin+serviceUrls[i]}>{service.link}<Icon size={19}/></a>
        </article>)}
      </div>
    </div>
  </section>
  <section id="why-seo-team" class="section why-section" aria-labelledby="why-title">
    <div class="container why-grid">
      <div class="why-intro"><div class="eyebrow"><span class="eyebrow-line"></span>{text(2,'Eyebrow')}</div><h2 id="why-title">{text(2,'H2')}</h2><p>{text(2,'Intro')}</p><div class="expertise-note"><span class="expertise-number">10<span>+</span></span><span>Years of experience<br/>in organic search</span></div><a class="text-link" href={origin+'/about-us'}>Meet SEO Team <Icon size={19}/></a></div>
      <div class="differences">
        {differences.map((block,i) => <details class="difference" name="difference" open={i===0}>
          <summary><span class="item-number">0{i+1}</span><h3>{block.title}</h3><span class="expand-icon"><Icon name="plus" size={20}/></span></summary>
          <div class="difference-body"><p>{block.body}</p>
          {block.tools.length>0 && <div class="technology-grid">{block.tools.map((tool,j)=><div class="technology"><Icon name={j===0?'target':'globe'} size={25}/><h4>{tool.title}</h4><p>{tool.body}</p></div>)}</div>}
          </div>
        </details>)}
      </div>
    </div>
  </section>
  <section id="approach" class="section approach-section" aria-labelledby="approach-title">
    <div class="container approach-grid">
      <div class="approach-copy"><div class="eyebrow"><span class="eyebrow-line"></span>{text(3,'Eyebrow')}</div><h2 id="approach-title">{text(3,'H2')}</h2><p>{text(3,'Body')}</p></div>
      <div class="authority-diagram" aria-label="Brand authority connects SEO, GEO and AEO through your website, your expertise, and credible third-party sources.">
        <div class="diagram-caption"><span class="eyebrow">One connected strategy</span><Icon name="layers" size={20}/></div>
        <div class="authority-core"><span>THE FOUNDATION</span><strong>Brand authority</strong><p>Credible expertise. Consistent signals.</p></div>
        <div class="connector-lines" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="search-channels"><div><span>01</span><strong>SEO</strong><p>Organic<br/>search</p></div><div><span>02</span><strong>GEO</strong><p>Generative<br/>engines</p></div><div><span>03</span><strong>AEO</strong><p>Answer<br/>engines</p></div></div>
        <div class="diagram-foundation"><span>Your website</span><span>Your expertise</span><span>Trusted sources</span></div>
      </div>
    </div>
  </section>
  <section id="case-studies" class="section cases-section" aria-labelledby="cases-title">
    <div class="container">
      <div class="section-heading case-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>{text(4,'Eyebrow')}</div><h2 id="cases-title">{text(4,'H2')}</h2><p>{text(4,'Body')}</p></div><a class="text-link" href={origin+'/case-studies'}>{text(4,'Link').replace(' →','')}<Icon size={20}/></a></div>
      <div class="case-grid">{cases.map((study,i)=><article class="case-card">
        <div class="case-top"><span class="eyebrow">{study.industry}</span><span class="item-number">0{i+1}</span></div>
        <div class="case-stat">{study.value}</div><p class="case-metric">{study.metric}</p>
        <div class="mini-comparison" aria-hidden="true"><div class="mini-before" style={`width:${100/study.after*100}%`}></div><div class="mini-after"></div></div>
        <p class="case-secondary">{study.secondary}</p>
        <div class="case-detail"><h3>{study.name}</h3><p>{study.focus}</p><a href={origin+study.href} class="text-link">Read Case Study <Icon size={18}/></a></div>
      </article>)}</div>
      <p class="results-note">Results from individual client engagements. Each case study explains the work and measurement behind the numbers.</p>
    </div>
  </section>
  <section id="industries" class="section industries-section" aria-labelledby="industries-title">
    <div class="container industry-layout">
      <div class="section-heading"><div class="eyebrow"><span class="eyebrow-line"></span>{text(5,'Eyebrow')}</div><h2 id="industries-title">{text(5,'H2')}</h2><p>{text(5,'Body')}</p><a href={origin+'/case-studies'} class="text-link">{text(5,'Link').replace(' →','')}<Icon size={20}/></a></div>
      <div class="industry-grid">{industries.map(industry=><a href={origin+industry.href} class="industry-link"><Icon name={industry.icon} size={23}/><span>{industry.name}</span><Icon size={17}/></a>)}</div>
    </div>
  </section>
  <section id="research" class="section research-section" aria-labelledby="research-title">
    <div class="container">
      <div class="section-heading case-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>{text(6,'Eyebrow')}</div><h2 id="research-title">{text(6,'H2')}</h2><p>{text(6,'Body')}</p></div><a href={origin+'/blog'} class="text-link">{text(6,'Link').replace(' →','')}<Icon size={20}/></a></div>
      <div class="article-list">{articles.map((article,i)=><article class="article-row"><span class="article-number">0{i+1}</span><div class="article-heading"><span class="eyebrow">{article.category}</span><h3><a href={origin+article.href}>{article.title}</a></h3></div><p>{article.description}</p><a href={origin+article.href} class="round-link" aria-label={`Read ${article.title}`}><Icon size={20}/></a></article>)}</div>
    </div>
  </section>
  <section id="testimonials" class="section testimonials-section" aria-labelledby="testimonials-title">
    <div class="container testimonial-layout">
      <div class="section-heading"><div class="eyebrow"><span class="eyebrow-line"></span>{text(7,'Eyebrow')}</div><h2 id="testimonials-title">{text(7,'H2')}</h2><p>{text(7,'Body')}</p></div>
      <div class="testimonial-carousel" role="region" aria-roledescription="carousel" aria-label="Client testimonials">
        <span class="quote-mark" aria-hidden="true">“</span>
        <div id="testimonial-slides" aria-live="polite">{testimonials.map((review,i)=><figure class="testimonial-slide" data-slide={i} role="group" aria-roledescription="slide" aria-label={`${i+1} of ${testimonials.length}`}>
          <blockquote>{review.quote}</blockquote><figcaption><strong>{review.name}</strong><span>{review.role}</span><a class="review-source" href={origin+review.href}>Read their case study <Icon size={14}/></a></figcaption>
        </figure>)}</div>
        <div class="testimonial-controls" hidden><div class="slide-dots" aria-label="Choose a testimonial">{testimonials.map((review,i)=><button type="button" data-go-to={i} aria-label={`Show testimonial from ${review.name}`} aria-pressed={i===0}><span></span></button>)}</div><div class="slide-navigation"><span id="slide-status">01 / 04</span><button type="button" class="round-link previous-slide" aria-label="Previous testimonial"><Icon size={20}/></button><button type="button" class="round-link next-slide" aria-label="Next testimonial"><Icon size={20}/></button></div></div>
      </div>
    </div>
  </section>
  <section id="contact" class="section contact-section" aria-labelledby="contact-title">
    <div class="container contact-layout"><div><div class="eyebrow"><span class="eyebrow-line"></span>{text(8,'Eyebrow')}</div><h2 id="contact-title">{text(8,'H2')}</h2><p>{text(8,'Body')}</p></div><div class="contact-actions"><a class="button" href={origin+'/contact'}>Speak With a Consultant <Icon size={20}/></a><a href="mailto:info@seoteamtoronto.ca" class="contact-link"><Icon name="mail" size={18}/>info@seoteamtoronto.ca</a><a href="tel:+14163603434" class="contact-link"><Icon name="phone" size={18}/>+1 416 360-3434</a></div></div>
  </section>
</main>
<footer class="site-footer"><div class="container"><div class="footer-top"><a href={base} class="brand" aria-label="SEO Team Toronto home"><img src={asset('seo-team-logo.svg')} width="131" height="58" alt="SEO Team Toronto" loading="lazy"/></a><p>60 Bloor St W, Unit 401<br/>Toronto, ON M4W 3B8</p><nav aria-label="Footer navigation"><a href={origin+'/about-us'}>About Us</a><a href="#services">Services</a><a href="#case-studies">Case Studies</a><a href="#research">Insights</a><a href="#contact">Contact</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} SEO Team Toronto. All rights reserved.</span><a href="https://www.brandvm.com/">In affiliation with <strong>Brand Vision</strong> <Icon name="external" size={13}/></a></div></div></footer>
<script>
  const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu.open=false;}));
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus();}});
  document.addEventListener('click',event=>{if(menu?.open&&event.target instanceof Node&&!menu.contains(event.target))menu.open=false;});
  const carousel=document.querySelector<HTMLElement>('.testimonial-carousel');
  if(carousel){
    const slides=Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots=Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-go-to]'));
    const controls=carousel.querySelector<HTMLElement>('.testimonial-controls');
    const status=carousel.querySelector<HTMLElement>('#slide-status');
    let active=0;
    const show=(index:number)=>{active=(index+slides.length)%slides.length;slides.forEach((slide,i)=>{slide.hidden=i!==active;});dots.forEach((dot,i)=>dot.setAttribute('aria-pressed',String(i===active)));if(status)status.textContent=`${String(active+1).padStart(2,'0')} / ${String(slides.length).padStart(2,'0')}`;};
    carousel.querySelector('.previous-slide')?.addEventListener('click',()=>show(active-1));
    carousel.querySelector('.next-slide')?.addEventListener('click',()=>show(active+1));
    dots.forEach((dot,i)=>dot.addEventListener('click',()=>show(i)));
    show(0);if(controls)controls.hidden=false;
  }
</script>
</body>
</html>
